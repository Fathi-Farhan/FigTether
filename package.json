{
  "name": "figtether-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation and publication checks for FigTether.",
  "author": "FigTether contributors",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "format": "prettier --write \"*.md\" \"*.json\" \"docs/**/*.md\" \"assets/*.md\" \"benchmarks/**/*.md\" \"benchmarks/published/*.json\" \"security/**/*.md\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"*.md\" \"*.json\" \"docs/**/*.md\" \"assets/*.md\" \"benchmarks/**/*.md\" \"benchmarks/published/*.json\" \"security/**/*.md\" \"scripts/*.mjs\"",
    "public:check": "node scripts/public-check.mjs && node scripts/render-readme-assets.mjs --check",
    "public:test": "node --test scripts/public-check.test.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.0"
  }
}
