{
  "$defs": {
    "CapabilityState": {
      "description": "State of one probed capability.",
      "oneOf": [
        {
          "description": "The capability is usable in this context.",
          "properties": {
            "status": {
              "const": "available",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "description": "The capability is not usable; `reason` explains why.",
          "properties": {
            "reason": {
              "description": "Why the capability is unavailable.",
              "type": "string"
            },
            "status": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The capability exists in the product but not in this platform or seat.",
          "properties": {
            "reason": {
              "description": "Where the capability would be supported.",
              "type": "string"
            },
            "status": {
              "const": "unsupported",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:figtether:schema:capabilities",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The capability report of one session.",
  "properties": {
    "probes": {
      "additionalProperties": {
        "$ref": "#/$defs/CapabilityState"
      },
      "default": {},
      "description": "Probed capabilities by name.",
      "type": "object"
    }
  },
  "title": "Capabilities",
  "type": "object"
}
