{
  "$defs": {
    "ConsistencyRequest": {
      "description": "Which consistency lane a read may use.",
      "oneOf": [
        {
          "const": "fresh",
          "description": "The default: the request must reach the plugin.",
          "type": "string"
        },
        {
          "const": "cached",
          "description": "Serve from the cache when the entry is younger than `max_age_ms`.",
          "type": "string"
        }
      ]
    },
    "SessionId": {
      "description": "Identity of one plugin run or tab.",
      "format": "uuid",
      "type": "string"
    },
    "SnapshotId": {
      "description": "Identity of one immutable capture.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$id": "urn:figtether:schema:get_nodes_params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Parameters of `get_nodes`.",
  "properties": {
    "consistency": {
      "$ref": "#/$defs/ConsistencyRequest",
      "default": "fresh",
      "description": "Consistency lane."
    },
    "depth": {
      "description": "Maximum depth to traverse below each node.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "fields": {
      "description": "Fields to project onto the response.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "max_age_ms": {
      "description": "Maximum age of a cached answer, in milliseconds.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "node_ids": {
      "description": "Node ids to read.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "session_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Live session to read. Mutually exclusive with `snapshot_id`."
    },
    "snapshot_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/SnapshotId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Snapshot to read. Mutually exclusive with `session_id`."
    }
  },
  "required": [
    "node_ids"
  ],
  "title": "GetNodesParams",
  "type": "object"
}
