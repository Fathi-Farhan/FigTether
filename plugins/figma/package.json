{
  "name": "@figtether/figma-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FigTether Figma plugin: main sandbox, UI iframe and the shared bridge wire contract.",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "build:types": "tsc -b shared/tsconfig.json",
    "typecheck": "node typecheck.mjs",
    "typecheck:build": "tsc -b tsconfig.json",
    "lint": "eslint shared build.mjs typecheck.mjs vitest.config.ts eslint.config.mjs",
    "lint:all": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,mts,cts,js,mjs,cjs,json,html,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,cts,js,mjs,cjs,json,html,css,md}\""
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "figtether-docs": "file:../.."
  }
}
