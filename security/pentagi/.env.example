# Environment of the PentAGI instance that runs the FigTether assessment.
#
# This file is an example. Copy it to `.env` next to the upstream
# `docker-compose.yml` of PentAGI, fill in the placeholders, and never commit
# the copy. The upstream installer writes its own `.env`; merge the values
# below into that file instead of replacing it.
#
# Everything in this file exists for one reason: keep the assessment from
# exposing anything that the assessment does not test on purpose.

## ---------------------------------------------------------------- the web console

# The console and the API stay on the loopback interface. Upstream binds
# 127.0.0.1 by default, and this assessment keeps that default, so the only
# machine that can reach the console is the machine that runs the assessment.
PENTAGI_LISTEN_IP=127.0.0.1
PENTAGI_LISTEN_PORT=8443

# The address the console is reached under. It stays on the loopback interface
# for the same reason as the listen address above.
PUBLIC_URL=https://localhost:8443
CORS_ORIGINS=https://localhost:8443

# The salt that signs the session cookies and the API tokens. Generate a
# random value for every instance, for example:
#   openssl rand -hex 32
# The value below is a placeholder and is not a secret of any instance.
COOKIE_SIGNING_SALT=change-me-to-a-random-value-per-instance

# The database of the instance. The password below is a placeholder. Change it
# before the stack starts, because the database port is published on the
# loopback interface.
PENTAGI_POSTGRES_USER=pentagi
PENTAGI_POSTGRES_PASSWORD=change-me-before-the-stack-starts
PENTAGI_POSTGRES_DB=pentagidb

## ---------------------------------------------------------------- the flow sandboxes

# The base host port of the port window that every flow publishes for its out
# of band callbacks. Each instance owns [DOCKER_PORTS_BASE, DOCKER_PORTS_BASE
# + 2000). The default of upstream is 28000. The value below moves the window
# to a range that no other instance of this machine uses, so two assessments
# never fight over the same port.
DOCKER_PORTS_BASE=28100

# The address the published sandbox ports are bound to. Upstream uses 0.0.0.0,
# which publishes them on every interface of the host. The assessment binds
# them to the loopback interface, so a flow sandbox never opens a port that the
# rest of the network can reach.
DOCKER_PUBLIC_IP=127.0.0.1

# The network of the flow sandbox.
#
# The FigTether daemon binds the loopback address only, by design. A sandbox
# that runs on a Docker bridge network has its own loopback interface and can
# therefore not reach the daemon at all, not even to be refused. The flow
# sandboxes of this assessment share the network stack of the host, so that
# 127.0.0.1 inside a sandbox is the loopback interface of the assessment host
# and the target of every flow prompt is the real target.
#
# This is the only deliberate exposure of the assessment, and it has a price:
# a sandbox that shares the network stack of the host binds its out of band
# listeners directly on the interfaces of the host, without a port mapping, so
# DOCKER_PUBLIC_IP does not limit them in this mode. Run the assessment on a
# host that is not reachable from the network, or restrict the port window
# above with a firewall in front of the host.
#
# The alternative is not acceptable for this assessment: making the daemon
# reachable on a non loopback address would remove the very trust model that
# the assessment is meant to validate.
DOCKER_NETWORK=host

# The image the sandbox uses. The fixed selection keeps the flow on the
# pentest image instead of letting the model pick one.
DOCKER_IMAGE_SELECTION_MODE=fixed

## ---------------------------------------------------------------- the model provider

# At least one model provider is required. Put the key of the provider that
# the assessment uses in the variable that belongs to it. The value below is a
# placeholder and is not a key.
OPEN_AI_KEY=replace-with-your-openai-key

# The other providers that the assessment accepts, all of them empty by
# default. Fill in exactly one of them.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
OLLAMA_SERVER_URL=
OLLAMA_SERVER_MODEL=

# The provider name that the scripts of the assessment submit with the
# createFlow mutation. It has to match the provider whose key is set above.
PENTAGI_ASSESSMENT_MODEL_PROVIDER=openai

## ---------------------------------------------------------------- the API token

# The Bearer token of the PentAGI API. It is created in the web console under
# Settings, PentAGI API, and it is shown only once. The scripts of the
# assessment read it from the environment, never from this file.
PENTAGI_API_TOKEN=

# The base URL of the console. The scripts of the assessment read it from the
# environment as well.
PENTAGI_BASE_URL=https://localhost:8443
